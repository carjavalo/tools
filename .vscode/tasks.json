{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Laravel: serve (elegir puerto)",
            "type": "shell",
            "command": "php",
            "args": [
                "artisan",
                "serve",
                "--port=${input:puerto}",
                "--host=0.0.0.0"
            ],
            "options": {
                "cwd": "${workspaceFolder}/tools"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ],
    "inputs": [
        {
            "id": "puerto",
            "type": "promptString",
            "description": "Puerto para el servidor Laravel",
            "default": "8000"
        }
    ]
}
